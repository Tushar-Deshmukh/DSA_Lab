{
  "name": "dsa-pattern-lab",
  "version": "0.1.0",
  "private": true,
  "description": "Self-paced DSA in JavaScript: lessons, visualizers, exercises, practice and spaced review.",
  "engines": {
    "node": ">=24.0.0 <25"
  },
  "scripts": {
    "predev": "npm run data:build",
    "dev": "next dev",
    "prebuild": "npm run data:build",
    "build": "npm run content:check && next build && node scripts/csp-hashes.mjs",
    "data:build": "tsx --conditions react-server scripts/build-runtime-data.ts",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "build:e2e": "node scripts/build-for-e2e.mjs",
    "test:e2e": "playwright test",
    "legacy:test": "node scripts/legacy-test.mjs",
    "check:deps": "node scripts/check-deps.mjs",
    "content:import": "tsx scripts/import-legacy.ts",
    "content:check": "tsx scripts/validate-content.ts",
    "content:lock": "tsx scripts/lock-ids.ts",
    "content:sync": "tsx scripts/sync-content.ts"
  },
  "dependencies": {
    "@better-auth/mongo-adapter": "1.7.16",
    "@codemirror/lang-javascript": "6.2.5",
    "@mdx-js/mdx": "3.1.1",
    "better-auth": "1.7.16",
    "cmdk": "1.1.1",
    "codemirror": "6.0.2",
    "js-yaml": "5.5.0",
    "lucide-react": "1.68.0",
    "minisearch": "7.2.0",
    "mongodb": "7.7.0",
    "mongoose": "9.11.4",
    "next": "16.4.5",
    "nodemailer": "10.3.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "remark-gfm": "4.0.1",
    "server-only": "0.0.1",
    "ts-fsrs": "6.0.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.64.1",
    "@tailwindcss/postcss": "4.3.4",
    "@types/mdast": "4.0.4",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitest/coverage-v8": "5.1.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.5",
    "js-yaml-legacy": "npm:js-yaml@4.1.0",
    "marked": "15.0.12",
    "mongodb-memory-server": "11.3.0",
    "playwright": "1.64.1",
    "prettier": "3.9.10",
    "remark-mdx": "3.1.1",
    "remark-parse": "11.0.0",
    "tailwindcss": "4.3.4",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "unified": "11.0.5",
    "unist-util-visit": "5.2.0",
    "vitest": "5.1.0"
  },
  "config": {
    "mongodbMemoryServer": {
      "version": "8.0.34"
    }
  }
}
