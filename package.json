{
  "name": "dsa-pattern-lab",
  "version": "0.1.0",
  "private": true,
  "description": "Self-paced DSA in JavaScript: lessons, visualizers, exercises, practice and spaced review.",
  "engines": {
    "node": ">=24.0.0 <25"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build && node scripts/csp-hashes.mjs",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "build:e2e": "node scripts/build-for-e2e.mjs",
    "test:e2e": "playwright test",
    "legacy:test": "node scripts/legacy-test.mjs",
    "check:deps": "node scripts/check-deps.mjs"
  },
  "dependencies": {
    "@better-auth/mongo-adapter": "1.7.16",
    "better-auth": "1.7.16",
    "cmdk": "1.1.1",
    "lucide-react": "1.68.0",
    "mongodb": "7.7.0",
    "mongoose": "9.11.4",
    "next": "16.4.5",
    "nodemailer": "10.3.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "server-only": "0.0.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.64.1",
    "@tailwindcss/postcss": "4.3.4",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitest/coverage-v8": "5.1.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.5",
    "mongodb-memory-server": "11.3.0",
    "playwright": "1.64.1",
    "prettier": "3.9.10",
    "tailwindcss": "4.3.4",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "vitest": "5.1.0"
  },
  "config": {
    "mongodbMemoryServer": {
      "version": "8.0.34"
    }
  }
}
