# Copy to .env.local for `npm run dev`. Every variable is checked at start-up (lib/env.ts); empty means unset.

# MongoDB. Locally, `docker compose up -d` starts a one-node replica set at this address.
# In production, the Atlas connection string (mongodb+srv://...).
MONGODB_URI=mongodb://localhost:27017/dsa-pattern-lab?replicaSet=rs0&directConnection=true
# Connections per server instance; keep small on serverless hosts with a free Atlas cluster.
MONGODB_MAX_POOL=10

# Better Auth. Generate the secret with:
#   node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# GitHub sign-in (optional). Leave both empty to hide the GitHub button.
# Callback URL to register in the GitHub OAuth app: <BETTER_AUTH_URL>/api/auth/callback/github
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Magic-link email:
#   console  development only: the link is printed in the terminal (default in development)
#   smtp     a real mailbox: Mailpit locally (smtp://localhost:1025), an email provider in production
#   none     email sign-in switched off (default in production until a provider is chosen)
# The sign-in page is static, so set this before `npm run build`.
EMAIL_TRANSPORT=console
SMTP_URL=smtp://localhost:1025
EMAIL_FROM="DSA Pattern Lab <no-reply@localhost>"
